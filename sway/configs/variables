# Setting mod to Windows Key
set $mod Mod4

# Setting vim bindings
set $left h
set $down j
set $up k
set $right l

# Setting applications
set $term ghostty

set $menu wmenu-run -N 24283B -n C0CAF5 -S 414868 -s C0CAF5 -b -f "sans-serif monospace 12"

set $browser firefox
set $uni_browser firefox -P Waikato

set $filebrowser ghostty -e yazi

set $notes emacs

set $background $HOME/.config/sway/backgrounds/gilbi.png

set $lockscreen swaylock -i $background

set $screenshot grim -g "$(slurp -d)" - | wl-copy
